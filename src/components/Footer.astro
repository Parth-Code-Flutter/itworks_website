---
const links = {
  company: [
    { name: "About Us", href: "#about" },
    { name: "Careers", href: "#careers" },
    { name: "Blog", href: "#blog" },
    { name: "Contact", href: "#contact" },
  ],
  services: [
    { name: "Web Development", href: "#" },
    { name: "Mobile Apps", href: "#" },
    { name: "Cloud Solutions", href: "#" },
    { name: "AI & Machine Learning", href: "#" },
  ],
  support: [
    { name: "Help Center", href: "#" },
    { name: "Terms of Service", href: "#" },
    { name: "Privacy Policy", href: "#" },
    { name: "Status", href: "#" },
  ],
};
---

<footer class="bg-card border-t border-border" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8">
        <a href="/" class="text-2xl font-bold font-[Outfit] text-foreground tracking-tighter block">
            IT<span class="text-blue-600 dark:text-blue-500">Works</span>.
        </a>
        <p class="text-sm leading-6 text-gray-600 dark:text-gray-400 max-w-sm">
          Empowering businesses with future-ready IT solutions. We build the software that powers the world's most innovative companies.
        </p>
        <div class="flex space-x-6">
            <!-- Social Placeholders -->
            {['Twitter', 'GitHub', 'LinkedIn', 'YouTube'].map((item) => (
                <a href="#" class="text-gray-400 hover:text-blue-600 dark:hover:text-blue-400">
                    <span class="sr-only">{item}</span>
                    <div class="h-6 w-6 bg-current rounded-full opacity-20 hover:opacity-100 transition-opacity"></div>
                </a>
            ))}
        </div>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-semibold leading-6 text-foreground">Company</h3>
            <ul role="list" class="mt-6 space-y-4">
              {links.company.map((item) => (
                <li>
                  <a href={item.href} class="text-sm leading-6 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-semibold leading-6 text-foreground">Services</h3>
            <ul role="list" class="mt-6 space-y-4">
              {links.services.map((item) => (
                <li>
                  <a href={item.href} class="text-sm leading-6 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-semibold leading-6 text-foreground">Support</h3>
            <ul role="list" class="mt-6 space-y-4">
              {links.support.map((item) => (
                <li>
                  <a href={item.href} class="text-sm leading-6 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-semibold leading-6 text-foreground">Contact</h3>
            <ul role="list" class="mt-6 space-y-4 text-sm leading-6 text-gray-600 dark:text-gray-400">
                <li>123 Innovation Dr.<br/>Tech City, TC 90210</li>
                <li>hello@itworks.com</li>
                <li>+1 (555) 123-4567</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-16 border-t border-border pt-8 sm:mt-20 lg:mt-24">
      <p class="text-xs leading-5 text-gray-500 text-center">
        &copy; 2025 ITWorks Company. All rights reserved.
      </p>
    </div>
  </div>
</footer>
