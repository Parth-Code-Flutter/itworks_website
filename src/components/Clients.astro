---
// Placeholder logos using text for now, but styled as logos
const clients = [
  "Google", "Microsoft", "AWS", "Oracle",
  "IBM", "Salesforce", "Adobe", "Intel"
];
---

<section class="py-20 bg-background">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Trusted by Market Leaders</h2>
      <p class="text-gray-600 dark:text-gray-400">We partner with the world's most innovative companies.</p>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-8 items-center opacity-70">
      {clients.map((client) => (
        <div class="flex items-center justify-center p-4 grayscale hover:grayscale-0 transition-all duration-300 opacity-60 hover:opacity-100 cursor-pointer">
           <!-- Placeholder for Logo - Using stylized text for now -->
           <span class="text-xl font-bold text-gray-800 dark:text-gray-200">{client}</span>
        </div>
      ))}
    </div>
  </div>
</section>
