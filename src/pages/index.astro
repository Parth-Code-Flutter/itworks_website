---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Clients from '../components/Clients.astro';
import Awards from '../components/Awards.astro';
import Footer from '../components/Footer.astro';
import { Server, ShieldCheck, Globe2 } from 'lucide-astro';
---

<Layout title="ITWorks - Modern IT Solutions Company">
	<Navbar />
	<main>
		<Hero />
        <Stats />
        <Clients />
        <Awards />
        
        <!-- Feature/Services Preview (Placeholder for next steps) -->
        <section class="py-20 bg-background">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                     <h2 class="text-3xl md:text-4xl font-bold mb-4 text-foreground">Why Choose Us</h2>
                     <p class="text-gray-600 dark:text-gray-400">Delivering excellence in every line of code.</p>
                </div>
                <div class="grid md:grid-cols-3 gap-8">
                    {[
                        {
                            title: "Enterprise Solutions",
                            description: "Scalable software architecture designed for high-performance business environments.",
                            icon: Server
                        },
                        {
                            title: "Cybersecurity First",
                            description: "Advanced security protocols ensuring your data remains protected against evolving threats.",
                            icon: ShieldCheck
                        },
                        {
                            title: "Global Connectivity",
                            description: "Cloud-native infrastructure that connects your business to the world with 99.9% uptime.",
                            icon: Globe2
                        }
                    ].map((feature) => (
                        <div class="p-8 rounded-3xl bg-card border border-border/50 hover:border-blue-500/30 transition-all hover:shadow-xl hover:-translate-y-1 group relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/5 rounded-bl-full -mr-10 -mt-10 transition-transform group-hover:scale-110"></div>
                            
                            <div class="w-14 h-14 bg-gradient-to-br from-blue-500/10 to-purple-500/10 rounded-2xl flex items-center justify-center mb-6 group-hover:from-blue-500/20 group-hover:to-purple-500/20 transition-colors border border-blue-500/10">
                                <feature.icon class="w-7 h-7 text-blue-600 dark:text-blue-400" />
                            </div>
                            <h3 class="text-xl font-bold mb-3 text-foreground">{feature.title}</h3>
                            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{feature.description}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>
	</main>
    
    <Footer />
</Layout>
