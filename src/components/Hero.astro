---
import { ArrowRight } from 'lucide-astro';
---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
  <!-- Background Gradients -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full z-0 pointer-events-none">
    <div class="absolute top-20 left-1/4 w-[500px] h-[500px] bg-blue-600/20 rounded-full blur-[100px] mix-blend-screen animate-pulse"></div>
    <div class="absolute top-40 right-1/4 w-[400px] h-[400px] bg-purple-600/20 rounded-full blur-[100px] mix-blend-screen"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-blue-400 text-sm font-medium mb-8">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
      </span>
      Accepting New Clients for 2025
    </div>

    <h1 class="text-5xl md:text-7xl font-extrabold text-foreground tracking-tight mb-8 leading-tight">
      Empowering Your Vision with <br class="hidden md:block" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600 dark:from-blue-400 dark:to-purple-500">
        Future-Ready IT Solutions
      </span>
    </h1>

    <p class="mt-4 max-w-2xl mx-auto text-xl text-gray-600 dark:text-gray-400 mb-10">
      We build scalable software, robust infrastructure, and AI-driven strategies to help your business thrive in the digital age.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="#projects" class="group w-full sm:w-auto px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-full transition-all hover:shadow-[0_0_30px_rgba(59,130,246,0.5)] transform hover:-translate-y-1 flex items-center justify-center gap-2">
        Explore Services
        <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
      </a>
      <a href="#contact" class="w-full sm:w-auto px-8 py-3.5 bg-transparent border border-border hover:border-foreground/50 text-foreground font-semibold rounded-full transition-all hover:bg-foreground/5">
        Let's Talk
      </a>
    </div>

    <!-- UI Mockup / Visual Placeholder -->
    <div class="mt-20 relative mx-auto max-w-5xl">
        <div class="rounded-xl bg-card border border-border p-2 backdrop-blur-sm shadow-2xl">
            <div class="rounded-lg bg-background aspect-video w-full overflow-hidden relative group">
                 <!-- Decorative grid lines or code snippet mockup could go here -->
                 <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
                 <div class="absolute inset-0 flex items-center justify-center">
                    <p class="text-gray-500 font-mono text-sm">Interactive Dashboard Visual</p>
                 </div>
            </div>
        </div>
    </div>
  </div>
</section>
