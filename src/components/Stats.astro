---
const stats = [
  { value: "15+", label: "Years Experience" },
  { value: "500+", label: "IT Experts" },
  { value: "1000+", label: "Projects Delivered" },
  { value: "98%", label: "Client Retention" },
];
---

<section class="py-20 border-b border-border bg-card/50">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-x divide-border/50">
      {stats.map((stat) => (
        <div class="p-4">
          <div class="text-4xl md:text-5xl font-extrabold text-blue-600 dark:text-blue-500 mb-2 font-[Outfit]">
            {stat.value}
          </div>
          <div class="text-gray-900 dark:text-gray-300 font-medium text-lg">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
